#!/usr/bin/env python3
"""herdrw — herdr 客户端包装器: 剥离输出中的 kitty 键盘协议序列。

背景 (herdr#3340): host 终端支持 kitty 键盘协议时 (如 rio), herdr client 会
push 协议 flag; rio 的 kitty 编码 (事件类型 :1/:3 后缀) 会触发 herdr 输入解码
的 bug, prefix 和弦 (ctrl+s 等) 全部失效。本包装器在 herdr 与 host 之间过滤:
push/pop/set/query/response 五类 `CSI ... u` 序列被丢弃, host 始终用 legacy
编码 (ctrl+s = 0x13), herdr 的 legacy 解析路径不受影响。

用法: herdrw [herdr 参数...]  (无参数等同 `herdr`)
仅当 host 是 rio 这类有此问题的终端时使用; 其他终端直接用 herdr。
"""
import fcntl
import os
import pty
import re
import select
import shutil
import signal
import sys
import termios
import time
import tty

# kitty 键盘协议 CSI 序列: 终结字节恒为 'u', 前导标记 <(pop) >(push) =(set) ?(query/应答)
KITTY_SEQ = re.compile(rb"^\x1b\[[<>=?][0-9;]*u$")
CSI_FINAL_MIN, CSI_FINAL_MAX = 0x40, 0x7E
HOLD = 0.2  # 不完整序列的保底冲刷时限 (秒)


class KittyFilter:
    """流式过滤器: 丢 kitty 协议 CSI, 其余字节原样放行。"""

    def __init__(self):
        self.buf = b""
        self.pending_since = None

    def feed(self, data, now):
        if self.pending_since is None and data:
            self.pending_since = now
        self.buf += data
        out = bytearray()
        while self.buf:
            idx = self.buf.find(b"\x1b[")
            if idx > 0:
                out += self.buf[:idx]
                self.buf = self.buf[idx:]
                continue
            if idx == -1:
                if self.buf.endswith(b"\x1b"):  # 可能是下一个序列的开头, 暂扣
                    out += self.buf[:-1]
                    self.buf = b"\x1b"
                else:
                    out += self.buf
                    self.buf = b""
                break
            # buffer 以 \x1b[ 开头: 扫描终结字节 (0x40-0x7E)
            j = 2  # 跳过 "\x1b[" 本身 ('[' = 0x5B 落在终结字节区间)
            n = len(self.buf)
            while j < n and not (CSI_FINAL_MIN <= self.buf[j] <= CSI_FINAL_MAX):
                j += 1
            if j == n:
                break  # 序列不完整, 等待更多数据 (flush 兜底)
            seq = bytes(self.buf[: j + 1])
            if not KITTY_SEQ.match(seq):
                out += seq  # 非 kitty 协议序列原样放行
            self.buf = self.buf[j + 1 :]
        if not self.buf:
            self.pending_since = None
        return bytes(out)

    def flush(self, now):
        """超时兜底: 卡住的残缺序列原样冲刷, 避免永久滞留。"""
        if self.buf and self.pending_since is not None and now - self.pending_since > HOLD:
            data, self.buf, self.pending_since = self.buf, b"", None
            return data
        return b""


def main():
    argv = sys.argv[1:] or ["herdr"]
    if not shutil.which(argv[0]):
        sys.exit(f"herdrw: 未找到 {argv[0]}")
    argv[0] = shutil.which(argv[0])

    stdin_fd = sys.stdin.fileno()
    try:
        saved_termios = termios.tcgetattr(stdin_fd)
        tty.setraw(stdin_fd, termios.TCSADRAIN)
    except termios.error:
        saved_termios = None  # stdin 非 tty (管道等): 仍可运行, 仅无窗口尺寸跟随

    pid, master = pty.fork()
    if pid == 0:  # 子进程: herdr client, 其 tty = pty slave
        try:
            os.execvp(argv[0], argv)
        finally:
            os._exit(127)

    # 初始窗口尺寸 + SIGWINCH 跟随
    def apply_winsize(*_):
        try:
            ws = fcntl.ioctl(stdin_fd, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    if saved_termios is not None:
        apply_winsize()
        signal.signal(signal.SIGWINCH, apply_winsize)

    def forward(signum, _frame):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)

    filt = KittyFilter()
    status = 0
    try:
        while True:
            try:
                r, _, _ = select.select([stdin_fd, master], [], [], 0.05)
            except InterruptedError:
                continue
            now = time.monotonic()
            if stdin_fd in r:
                try:
                    data = os.read(stdin_fd, 65536)
                except OSError:
                    data = b""
                if data:
                    # 输入方向直通; EIO/短写忽略
                    try:
                        os.write(master, data)
                    except OSError:
                        pass
                else:
                    forward(signal.SIGHUP)  # stdin EOF: 让 herdr 收尾
            if master in r:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    data = b""  # EIO = 子进程已退出
                if not data:
                    break
                try:
                    os.write(sys.stdout.fileno(), filt.feed(data, now))
                except OSError:
                    break
            tail = filt.flush(now)
            if tail:
                try:
                    os.write(sys.stdout.fileno(), tail)
                except OSError:
                    break
            # 收尸
            wpid, wstatus = os.waitpid(pid, os.WNOHANG)
            if wpid == pid:
                status = os.waitstatus_to_exitcode(wstatus)
                break
        # 排干子进程残余输出
        deadline = time.monotonic() + 0.5
        while time.monotonic() < deadline:
            r, _, _ = select.select([master], [], [], 0.1)
            if not r:
                break
            try:
                data = os.read(master, 65536)
            except OSError:
                break
            if not data:
                break
            now = time.monotonic()
            try:
                os.write(sys.stdout.fileno(), filt.feed(data, now) or filt.flush(now))
            except OSError:
                break
    finally:
        if saved_termios is not None:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, saved_termios)
        try:
            os.close(master)
        except OSError:
            pass
        try:
            _, wstatus = os.waitpid(pid, 0)
            status = os.waitstatus_to_exitcode(wstatus)
        except ChildProcessError:
            pass
    sys.exit(status)


if __name__ == "__main__":
    main()
