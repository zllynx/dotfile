#!/bin/sh
# 收工通知: 自动识别平台 (macOS / WSL / Windows Git Bash / 其他 Linux)
# 用法: omp-done "任务描述"
msg=${1:-任务完成}

# herdr 感知: macOS 上 herdr 的 agent 集成会在 agent 完成/需要输入时自动发
# 桌面通知 (delivery=terminal), 这里再发就是双响; 静默退出让 herdr 全权通知.
# WSL/其他平台 herdr 桌面通知不可用 (无 OSC 检测/无 dbus), 继续走下面的兜底.
if [ "$(uname -s)" = Darwin ] && [ -n "$HERDR_PANE_ID" ]; then
  exit 0
fi

case "$(uname -s)" in
Darwin)
  esc=$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g')
  exec osascript -e "display notification \"$esc\" with title \"omp\" sound name \"default\""
  ;;
*)
  printf '\a'  # BEL 终端铃声
  # powershell.exe 在 PATH = WSL 或 Windows (Git Bash/MSYS)；纯 Linux 无此项，只响铃
  if command -v powershell.exe >/dev/null 2>&1; then
    esc=$(printf '%s' "$msg" | sed "s/'/''/g")
    powershell.exe -NoProfile -Command "
      Add-Type -AssemblyName System.Windows.Forms, System.Drawing
      \$n = New-Object System.Windows.Forms.NotifyIcon
      \$n.Icon = [System.Drawing.SystemIcons]::Information
      \$n.Visible = \$true
      \$n.ShowBalloonTip(5000, 'omp', '$esc', [System.Windows.Forms.ToolTipIcon]::Info)
      Start-Sleep -Seconds 6
      \$n.Dispose()" &
  fi
  ;;
esac
