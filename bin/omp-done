#!/bin/sh
# 收工通知: 自动识别平台 (macOS / WSL / Windows Git Bash / 其他 Linux)
# 用法: omp-done "任务描述"
msg=${1:-任务完成}

# 注: 曾有 "herdr pane 内静默" 守卫, 因 herdr delivery 改为 herdr(仅应用内,
# 桌面英文横幅关闭)而移除 — omp-done 重新成为 macOS 上完成通知的唯一来源.
# blocked 场景由 ~/dotfile/launchd/omp-herdr-watch.sh 负责 (见 launchd 同目录).

case "$(uname -s)" in
Darwin)
  # 统一模板: title "omp · 完成" (见 bin/omp-notify)
  exec "$HOME/dotfile/bin/omp-notify" "完成" "$msg"
  ;;
*)
  # powershell.exe 在 PATH = WSL 或 Windows (Git Bash/MSYS)；纯 Linux 无此项，只响铃
  printf '\a'
  if command -v powershell.exe >/dev/null 2>&1; then
    esc=$(printf '%s' "$msg" | sed "s/'/''/g")
    powershell.exe -NoProfile -Command "
      Add-Type -AssemblyName System.Windows.Forms, System.Drawing
      \$n = New-Object System.Windows.Forms.NotifyIcon
      \$n.Icon = [System.Drawing.SystemIcons]::Information
      \$n.Visible = \$true
      \$n.ShowBalloonTip(5000, 'omp · 完成', '$esc', [System.Windows.Forms.ToolTipIcon]::Info)
      Start-Sleep -Seconds 6
      \$n.Dispose()" &
  fi
  ;;
esac
