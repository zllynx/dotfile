{
    "title": "zhenli custom rules",
    "rules": [
        {
            "description": "Change right_command to command+control+option+shift.",
            "manipulators": [
                {
                    "from": {
                        "key_code": "right_command",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "modifiers": [
                                "left_command",
                                "left_control",
                                "left_option"
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Change fn -> w to play_or_pause",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"w",
                        "modifiers": {
                            "mandatory": ["fn"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "play_or_pause"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control -> f to right",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"f",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "right_arrow"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control -> b to left",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"b",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "left_arrow"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control -> p to up",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"p",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "up_arrow"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control -> n to down",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"n",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "down_arrow"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control+ command-> f to end",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"f",
                        "modifiers": {
                            "mandatory": ["left_control",
                                        "left_command"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "end"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control + left_command -> b to Home",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"b",
                        "modifiers": {
                            "mandatory": ["left_control","left_command"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "home"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control + left_command -> p to page_up",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"p",
                        "modifiers": {
                            "mandatory": ["left_control","left_command"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "page_up"
                        }
                    ]
                }
            ] 
        },
        {
            "description": "Change left_control + left_command-> n to page_down",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code":"n",
                        "modifiers": {
                            "mandatory": ["left_control","left_command"]
                        }
                    },
                    "to":[
                        {
                            "key_code": "page_down"
                        }
                    ]
                }
            ] 
        } 
    ]
}
